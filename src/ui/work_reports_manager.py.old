"""
Gestión de partes de obra
"""
import tkinter as tk
from tkinter import ttk, simpledialog, StringVar, Toplevel
from src.database import db
from src.ui.ui_utils import (
    center_window, create_styled_button, create_search_frame,
    create_treeview_with_scrollbar, show_info, show_error,
    show_warning, ask_yes_no, create_clients_combobox,
    create_quotes_combobox, create_date_entry
)
from datetime import datetime, timedelta


class WorkReportsFrame(ttk.Frame):
    """Frame para gestión de partes de obra"""
    
    def __init__(self, master, app):
        super().__init__(master)
        self.app = app
        self._setup_ui()
        self.refresh()
    
    def _setup_ui(self):
        """Configura la interfaz"""
        # Barra de búsqueda
        self.search_var = tk.StringVar()
        self.search_var.trace('w', lambda *args: self.refresh())
        search_frame, search_entry = create_search_frame(self, self.search_var)
        
        # Tabla de partes
        columns = ('id', 'work_name', 'client', 'date_range', 'quote_id', 'workers', 'status')
        headings = ('#', 'Obra', 'Cliente', 'Periodo', 'Presupuesto', 'Trabajadores', 'Estado')
        column_widths = (50, 200, 150, 150, 100, 150, 100)
        
        tree_frame, self.tree = create_treeview_with_scrollbar(
            self, columns, headings, column_widths
        )
        
        # Doble click para editar
        self.tree.bind('<Double-Button-1>', lambda e: self.edit_report())
        
        # Panel de botones principal
        btn_frame = ttk.Frame(self)
        btn_frame.pack(fill='x', padx=10, pady=5)
        
        left_btns = ttk.Frame(btn_frame)
        left_btns.pack(side='left', fill='x')
        
        # Botones principales
        create_styled_button(
            left_btns, '+ Nuevo Parte', self.new_report, 'success'
        ).pack(side='left', padx=5)
        
        create_styled_button(
            left_btns, '✏️ Editar', self.edit_report, 'primary'
        ).pack(side='left', padx=5)
        
        create_styled_button(
            left_btns, '🗑️ Eliminar', self.delete_report, 'danger'
        ).pack(side='left', padx=5)
        
        # Botones de exportación
        right_btns = ttk.Frame(btn_frame)
        right_btns.pack(side='right', fill='x')
        
        create_styled_button(
            right_btns, '📄 Exportar PDF', self.export_pdf, 'info'
        ).pack(side='right', padx=5)
        
        create_styled_button(
            right_btns, '� Exportar Excel', self.export_excel, 'info'
        ).pack(side='right', padx=5)
        
        # Panel de filtros
        filter_frame = ttk.LabelFrame(self, text='Filtros')
        filter_frame.pack(fill='x', padx=10, pady=5)
        
        # Primera fila de filtros
        filter_row1 = ttk.Frame(filter_frame)
        filter_row1.pack(fill='x', padx=5, pady=5)
        
        ttk.Label(filter_row1, text='Periodo:').pack(side='left', padx=5)
        self.date_filter = ttk.Combobox(filter_row1, width=15, values=[
            'Todos', 'Esta semana', 'Este mes', 'Último mes', 'Este año'
        ])
        self.date_filter.set('Este mes')
        self.date_filter.pack(side='left', padx=5)
        self.date_filter.bind('<<ComboboxSelected>>', lambda e: self.refresh())
        
        ttk.Label(filter_row1, text='Cliente:').pack(side='left', padx=5)
        self.client_filter = ttk.Entry(filter_row1, width=20)
        self.client_filter.pack(side='left', padx=5)
        self.client_filter.bind('<KeyRelease>', lambda e: self.refresh())
        
        # Segunda fila de filtros
        filter_row2 = ttk.Frame(filter_frame)
        filter_row2.pack(fill='x', padx=5, pady=5)
        
        ttk.Label(filter_row2, text='Estado:').pack(side='left', padx=5)
        self.status_filter = ttk.Combobox(filter_row2, width=15, values=[
            'Todos', 'En progreso', 'Completado', 'Facturado'
        ])
        self.status_filter.set('Todos')
        self.status_filter.pack(side='left', padx=5)
        self.status_filter.bind('<<ComboboxSelected>>', lambda e: self.refresh())
        
        ttk.Label(filter_row2, text='Trabajador:').pack(side='left', padx=5)
        self.worker_filter = ttk.Entry(filter_row2, width=20)
        self.worker_filter.pack(side='left', padx=5)
        self.worker_filter.bind('<KeyRelease>', lambda e: self.refresh())
    
    def refresh(self):
        """Actualiza la lista de partes"""
        # Limpiar tabla
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        # Obtener filtros
        search_term = self.search_var.get().lower()
        date_filter = self.date_filter.get()
        status_filter = self.status_filter.get()
        client_filter = self.client_filter.get().lower()
        worker_filter = self.worker_filter.get().lower()
        
        # Cargar partes
        reports = db.list_work_reports()
        
        # Configurar tags para filas alternadas y estados
        self.tree.tag_configure('oddrow', background='#FFFFFF')
        self.tree.tag_configure('evenrow', background='#F0F4F8')
        self.tree.tag_configure('in-progress', foreground='#1976D2')  # Azul
        self.tree.tag_configure('completed', foreground='#388E3C')    # Verde
        self.tree.tag_configure('invoiced', foreground='#7B1FA2')    # Morado
        
        row_count = 0
        for report in reports:
            # Aplicar filtros
            if not self._report_matches_filters(
                report, search_term, date_filter, 
                status_filter, client_filter, worker_filter
            ):
                continue
            
            # Preparar datos para mostrar
            tags = ['evenrow' if row_count % 2 == 0 else 'oddrow']
            tags.append(report['status'].lower().replace(' ', '-'))
            
            quote_text = f"#{report['quote_id']}" if report['quote_id'] else 'Sin presup.'
            date_range = f"{report['start_date']} - {report['end_date']}"
            workers_text = ', '.join(report['workers']) if report['workers'] else 'Sin asignar'
            
            # Insertar en tabla
            self.tree.insert('', 'end', iid=str(report['id']), values=(
                report['id'],
                report['work_name'],
                report['client_name'] or '',
                date_range,
                quote_text,
                workers_text,
                report['status']
            ), tags=tuple(tags))
            
            row_count += 1
            
    def _report_matches_filters(self, report, search, date_filter, 
                              status_filter, client_filter, worker_filter):
        """Comprueba si un parte cumple los criterios de filtrado"""
        # Búsqueda general
        if search:
            work_name = report['work_name'] or ''
            client_name = report['client_name'] or ''
            if search not in work_name.lower() and search not in client_name.lower():
                return False
                
        # Filtro de fecha
        if date_filter != 'Todos':
            start_date = datetime.strptime(report['start_date'], '%Y-%m-%d')
            today = datetime.today()
            
            if date_filter == 'Esta semana':
                week_start = today - timedelta(days=today.weekday())
                if start_date < week_start:
                    return False
            elif date_filter == 'Este mes':
                month_start = today.replace(day=1)
                if start_date < month_start:
                    return False
            elif date_filter == 'Último mes':
                last_month = today.replace(day=1) - timedelta(days=1)
                month_start = last_month.replace(day=1)
                if not month_start <= start_date <= last_month:
                    return False
            elif date_filter == 'Este año':
                year_start = today.replace(month=1, day=1)
                if start_date < year_start:
                    return False
        
        # Filtro de estado
        if status_filter != 'Todos' and report['status'] != status_filter:
            return False
            
        # Filtro de cliente
        if client_filter:
            client_name = report['client_name'] or ''
            if client_filter not in client_name.lower():
                return False
                
        # Filtro de trabajador
        if worker_filter:
            workers = [w.lower() for w in report['workers']] if report['workers'] else []
            if not any(worker_filter in w for w in workers):
                return False
                
        return True
    
    def new_report(self):
        """Abre el diálogo para crear un nuevo parte de trabajo"""
        dialog = Toplevel(self)
        dialog.title("Nuevo Parte de Trabajo")
        dialog.geometry("1200x800")
        dialog.minsize(1200, 800)
        
        dialog.grab_set()  # Modal
        
        # Variables
        name_var = StringVar()
        client_var = StringVar()
        start_date_var = StringVar()
        end_date_var = StringVar()
        quote_var = StringVar()
        status_var = StringVar(value='En progreso')
        
        # Frame principal
        main_container = ttk.Frame(dialog, padding=10)
        main_container.pack(fill='both', expand=True)
        
        # Panel superior - Detalles del parte
        top_frame = ttk.LabelFrame(main_container, text='Detalles del Parte', padding=10)
        top_frame.pack(fill='x', pady=(0,10))
        
        # Primera fila
        row1 = ttk.Frame(top_frame)
        row1.pack(fill='x', pady=(0,10))
        
        # Nombre de la obra
        name_frame = ttk.Frame(row1)
        name_frame.pack(side='left', fill='x', expand=True, padx=(0,5))
        ttk.Label(name_frame, text='Nombre de la Obra:').pack(anchor='w')
        name_entry = ttk.Entry(name_frame, textvariable=name_var)
        name_entry.pack(fill='x')
        
        # Cliente
        client_frame = ttk.Frame(row1)
        client_frame.pack(side='left', fill='x', expand=True, padx=5)
        ttk.Label(client_frame, text='Cliente:').pack(anchor='w')
        client_combo = create_clients_combobox(client_frame, client_var)
        client_combo.pack(fill='x')
        
        # Segunda fila
        row2 = ttk.Frame(top_frame)
        row2.pack(fill='x', pady=(0,10))
        
        # Fecha inicial
        start_date_frame = ttk.Frame(row2)
        start_date_frame.pack(side='left', fill='x', expand=True, padx=(0,5))
        ttk.Label(start_date_frame, text='Fecha Inicial:').pack(anchor='w')
        start_date_entry = create_date_entry(start_date_frame, start_date_var)
        start_date_entry.pack(fill='x')
        
        # Fecha final
        end_date_frame = ttk.Frame(row2)
        end_date_frame.pack(side='left', fill='x', expand=True, padx=5)
        ttk.Label(end_date_frame, text='Fecha Final:').pack(anchor='w')
        end_date_entry = create_date_entry(end_date_frame, end_date_var)
        end_date_entry.pack(fill='x')
        
        # Tercera fila
        row3 = ttk.Frame(top_frame)
        row3.pack(fill='x')
        
        # Presupuesto
        quote_frame = ttk.Frame(row3)
        quote_frame.pack(side='left', fill='x', expand=True, padx=(0,5))
        ttk.Label(quote_frame, text='Presupuesto:').pack(anchor='w')
        quote_combo = create_quotes_combobox(quote_frame, quote_var)
        quote_combo.pack(fill='x')
        
        # Estado
        status_frame = ttk.Frame(row3)
        status_frame.pack(side='left', fill='x', expand=True, padx=5)
        ttk.Label(status_frame, text='Estado:').pack(anchor='w')
        status_combo = ttk.Combobox(status_frame, textvariable=status_var, values=[
            'En progreso', 'Completado', 'Facturado'
        ], state='readonly')
        status_combo.pack(fill='x')
        
        # Panel central - Matriz de trabajo
        matrix_frame = ttk.LabelFrame(main_container, text='Asignación de Trabajo', padding=10)
        matrix_frame.pack(fill='both', expand=True, pady=(0,10))
        
        # Panel inferior - Materiales
        materials_frame = ttk.LabelFrame(main_container, text='Materiales', padding=10)
        materials_frame.pack(fill='x', pady=(0,10))
        
        # Botones de acción
        btn_frame = ttk.Frame(main_container)
        btn_frame.pack(fill='x')
        
        # Botones lado izquierdo
        left_btns = ttk.Frame(btn_frame)
        left_btns.pack(side='left')
        
        create_styled_button(
            left_btns,
            '➕ Agregar Trabajador',
            lambda: self.add_worker_to_matrix(),
            'primary'
        ).pack(side='left', padx=5)
        
        create_styled_button(
            left_btns,
            '🛠️ Agregar Material',
            lambda: self.add_material_to_report(),
            'primary'
        ).pack(side='left', padx=5)
        
        # Botones lado derecho
        right_btns = ttk.Frame(btn_frame)
        right_btns.pack(side='right')
        
        create_styled_button(
            right_btns,
            'Guardar',
            lambda: self.save_report(
                dialog,
                name_var.get(),
                client_var.get(),
                {
                    'start': start_date_var.get(),
                    'end': end_date_var.get()
                },
                quote_var.get(),
                status_var.get()
            ),
            'success'
        ).pack(side='right', padx=5)
        
        create_styled_button(
            right_btns,
            'Cancelar',
            dialog.destroy,
            'danger'
        ).pack(side='right', padx=5)
        
        name_entry.focus()
    
    def edit_report(self):
        """Edita el parte seleccionado"""
        selection = self.tree.selection()
        if not selection:
            show_warning('Advertencia', 'Selecciona un parte', self)
            return
        
        report_id = int(selection[0])
        WorkReportEditor(self, report_id=report_id, on_save=lambda: self.refresh())
    
